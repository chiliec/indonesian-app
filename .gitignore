.superpowers/
.gradle/
build/
*.iml
.idea/
local.properties
xcuserdata/
.DS_Store
content-prep/node_modules/

.kotlin/

# Release signing secrets — never commit
keystore.properties
*.jks
*.jks.*
*.keystore
*.bak
upload-keystore.jks*

# Built distributable APKs
dist/
*.apk

# iOS CI signing secrets — never commit
AuthKey_*.p8
*.p12
*.mobileprovision
vendor/bundle/
.bundle/

# fastlane Gemfile.lock is resolved by CI under its own Ruby (avoids ruby-version pin drift)
Gemfile.lock

# deliver stages screenshots here at runtime from docs/store-assets/ios (single source of truth)
fastlane/screenshots/

# supply stages the Play listing here at runtime from docs/store-assets (single source of truth)
fastlane/play-metadata/

# Play service account key (Release-manager JSON) — never commit
play-service-account.json

# Built app bundle
*.aab

# local ASC API creds for fastlane (dotenv auto-load); .env.example is tracked
fastlane/.env

# personal review-contact phone (kept local; other review_information files are tracked)
fastlane/metadata/review_information/phone_number.txt

# fastlane auto-generated artifacts
fastlane/report.xml
fastlane/README.md
