# Template for fastlane/.env (copy to fastlane/.env and fill in — .env is gitignored).
# App Store Connect API credentials, used by every lane via the asc_api_key helper.
#
#   ASC_KEY_ID     Key ID of the ASC API key. Matches the AuthKey_<id>.p8 filename
#                  in the repo root (auto-discovered if omitted).
#   ASC_ISSUER_ID  Issuer ID (UUID) — App Store Connect → Users and Access →
#                  Integrations → App Store Connect API → Issuer ID.

ASC_KEY_ID=948K3FKL2H
ASC_ISSUER_ID=
