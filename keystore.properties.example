# Copy to keystore.properties (gitignored) to enable signed release builds.
# The active upload key is lancar-release.jks (alias lancar). Generate a fresh
# upload keystore only if you need a different key:
#   keytool -genkeypair -v -keystore lancar-release.jks -alias lancar \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -dname "CN=Lancar, O=viz.cx, C=US"
#
# With Google Play App Signing enabled, this is only the UPLOAD key — if lost it
# can be reset via the Play Console. Still: BACK IT UP and keep the passwords safe.
storeFile=lancar-release.jks
storePassword=CHANGE_ME
keyAlias=lancar
keyPassword=CHANGE_ME
